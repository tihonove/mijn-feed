PORT=3000
DATA_DIR=./data
# Comma-separated Google accounts allowed to sign in
OWNER_EMAILS=tihonov.ea@gmail.com
# Bearer token for content producers (any long random string)
PRODUCER_TOKEN=change-me
# Signs session cookies (any long random string)
SESSION_SECRET=change-me
# Google OAuth client (Web application). Leave empty to use /auth/dev in development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: GET /auth/dev signs in as the first OWNER_EMAILS without Google
DEV_LOGIN=1
# ElevenLabs, used by producers (not by the server)
ELEVENLABS_API_KEY=
